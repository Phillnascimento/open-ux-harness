{
  "id": "freelance",
  "name": "Freelancer / Lean UX",
  "description": "Perfil otimizado para designers autônomos e pequenos produtos. Usa tokens em JSON simples, protótipos em HTML/Tailwind/React e auditoria A11y local, sem dependência de Storybook corporativo ou telemetria em nuvem.",
  "tokens": {
    "format": "simple-json",
    "strictDtcg": false,
    "outputFiles": ["./tokens/tokens.json", "./tokens/tailwind.tokens.js"]
  },
  "figma": {
    "mode": "rest-or-manual",
    "useDesktopBridge": false,
    "fallbackToCodeOnly": true
  },
  "handoff": {
    "destination": "code-snippets",
    "formats": ["react-tailwind", "html-css"],
    "requireStorybook": false
  },
  "analytics": {
    "provider": "local-feedback",
    "requireTelemetryServer": false
  },
  "mcpServers": [
    "figma",
    "a11y-scanner",
    "local-tokens"
  ],
  "governance": {
    "confirmMasterChanges": true,
    "allowRapidPrototyping": true
  },
  "modes": {
    "micro": [
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "sprint": [
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "full": [
      "00-skill-architect",
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "06-zero-drift-handoff",
      "07-telemetry-and-impact",
      "08-reality-gate",
      "09-persona-walkthrough",
      "li-career",
      "li-brand",
      "li-voice",
      "li-profile",
      "li-human",
      "li-plan",
      "li-repurpose",
      "li-post",
      "li-carousel",
      "li-comment",
      "li-reply",
      "li-dm",
      "li-inbox",
      "li-audit"
    ]
  }
}
