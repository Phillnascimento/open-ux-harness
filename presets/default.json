{
  "id": "default",
  "name": "Standard Balanced UX",
  "description": "Perfil equilibrado com suporte a tokens W3C simples, prototipação em React/Tailwind e auditoria WCAG 2.2 automatizada.",
  "tokens": {
    "format": "w3c-dtcg-2025.10",
    "strictDtcg": false,
    "outputFiles": ["./tokens/tokens.json"]
  },
  "figma": {
    "mode": "rest-with-plugin-option",
    "useDesktopBridge": false,
    "fallbackToCodeOnly": true
  },
  "handoff": {
    "destination": "components-and-specs",
    "formats": ["react-tailwind", "html-css"],
    "requireStorybook": false
  },
  "analytics": {
    "provider": "optional-posthog",
    "requireTelemetryServer": false
  },
  "mcpServers": [
    "figma",
    "a11y-scanner",
    "local-tokens"
  ],
  "governance": {
    "confirmMasterChanges": true,
    "designGateRequired": false
  },
  "modes": {
    "micro": [
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "sprint": [
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "full": [
      "00-skill-architect",
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "06-zero-drift-handoff",
      "07-telemetry-and-impact",
      "08-reality-gate",
      "09-persona-walkthrough",
      "li-career",
      "li-brand",
      "li-voice",
      "li-profile",
      "li-human",
      "li-plan",
      "li-repurpose",
      "li-post",
      "li-carousel",
      "li-comment",
      "li-reply",
      "li-dm",
      "li-inbox",
      "li-audit"
    ]
  }
}
