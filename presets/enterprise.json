{
  "id": "enterprise",
  "name": "Enterprise / Scale DesignOps",
  "description": "Perfil de alto rigor técnico para equipes multidisciplinares corporativas. Conecta Figma Console bidirecional via WebSocket, W3C DTCG 2025.10 com linter asimonim, Storybook MCP com visual regression Playwright, e telemetria analítica com PostHog.",
  "tokens": {
    "format": "w3c-dtcg-2025.10",
    "strictDtcg": true,
    "linter": "asimonim",
    "outputFiles": ["./tokens/design-tokens.tokens.json", "./tokens/style-dictionary.config.json"]
  },
  "figma": {
    "mode": "figma-console-websocket",
    "useDesktopBridge": true,
    "fallbackToCodeOnly": false
  },
  "handoff": {
    "destination": "storybook-and-repo",
    "formats": ["react-typescript", "storybook-stories", "figma-code-connect"],
    "requireStorybook": true
  },
  "analytics": {
    "provider": "posthog",
    "requireTelemetryServer": true
  },
  "mcpServers": [
    "figma-console",
    "storybook",
    "posthog",
    "asimonim-dtcg",
    "a11y-scanner",
    "jira-notion"
  ],
  "governance": {
    "confirmMasterChanges": true,
    "designGateRequired": true,
    "requirePrApproval": true
  },
  "modes": {
    "micro": [
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "sprint": [
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "08-reality-gate",
      "06-zero-drift-handoff"
    ],
    "full": [
      "00-skill-architect",
      "01-briefing-discovery",
      "02-information-architecture",
      "03-design-tokens",
      "04-figma-engineering",
      "05-craft-and-accessibility",
      "06-zero-drift-handoff",
      "07-telemetry-and-impact",
      "08-reality-gate",
      "09-persona-walkthrough",
      "10-ux-humanizer",
      "li-career",
      "li-brand",
      "li-voice",
      "li-profile",
      "li-human",
      "li-plan",
      "li-repurpose",
      "li-post",
      "li-carousel",
      "li-comment",
      "li-reply",
      "li-dm",
      "li-inbox",
      "li-audit"
    ]
  }
}
