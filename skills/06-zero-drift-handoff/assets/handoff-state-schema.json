{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open UX Harness — 06 Zero-Drift Handoff State Contract",
  "description": "Schema determinístico de estado e handoff salvo em .harness/memory/handoff-state.json ao concluir a skill 06-zero-drift-handoff.",
  "type": "object",
  "required": [
    "status",
    "skill_id",
    "timestamp",
    "preset_mode",
    "confidence_score",
    "validation_errors",
    "payload",
    "nextStepRouting"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "warning", "failed", "SCHEMA_MISMATCH"],
      "description": "Status final da execução da skill e do validador validate-handoff-spec.ts."
    },
    "skill_id": {
      "type": "string",
      "const": "06-zero-drift-handoff",
      "description": "Identificador canônico da skill 06-zero-drift-handoff."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 da conclusão do handoff."
    },
    "preset_mode": {
      "type": "string",
      "enum": ["freelance", "enterprise", "default"],
      "description": "Perfil operacional em que o handoff foi gerado."
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Índice de confiança calculado pelo script validate-handoff-spec.ts."
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "field_or_line": { "type": "string" }
        }
      },
      "description": "Lista de violações de Design Drift ou estados Gherkin ausentes."
    },
    "payload": {
      "type": "object",
      "required": [
        "spec_artifact_path",
        "components_mapped",
        "reuse_ratio",
        "gherkin_states_covered",
        "zero_hardcoded_values"
      ],
      "properties": {
        "spec_artifact_path": {
          "type": "string",
          "description": "Caminho do arquivo Markdown de especificação de handoff gerado."
        },
        "components_mapped": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["component_name", "catalog_decision", "target_path"],
            "properties": {
              "component_name": { "type": "string" },
              "catalog_decision": {
                "type": "string",
                "enum": ["REUSE", "EXTEND", "NEW_COMPONENT"]
              },
              "target_path": { "type": "string" },
              "figma_node_id": { "type": "string" },
              "storybook_story_id": { "type": "string" },
              "code_connect_ready": { "type": "boolean" }
            }
          }
        },
        "reuse_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Proporção de componentes reutilizados/estendidos em relação ao total mapeado."
        },
        "gherkin_states_covered": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "default",
              "hover",
              "focus-visible",
              "active",
              "loading",
              "disabled",
              "error",
              "empty",
              "overflow"
            ]
          },
          "description": "Lista de estados interativos cobertos nos cenários Gherkin da especificação."
        },
        "zero_hardcoded_values": {
          "type": "boolean",
          "description": "True se nenhum valor hexadecimal ou pixel arbitrário hardcoded foi detectado."
        }
      }
    },
    "nextStepRouting": {
      "type": "object",
      "required": ["recommendedPath", "pathA", "pathB"],
      "properties": {
        "recommendedPath": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "pathA": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": {
              "type": "string",
              "const": "07-telemetry-and-impact"
            },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "pathB": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": {
              "type": "string",
              "const": "05-craft-and-accessibility"
            },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    }
  }
}
