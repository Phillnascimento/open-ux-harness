{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open UX Harness — 07 Telemetry and Impact State Contract",
  "description": "Schema determinístico de estado e handoff salvo em .harness/memory/telemetry-state.json ao concluir a skill 07-telemetry-and-impact.",
  "type": "object",
  "required": [
    "status",
    "skill_id",
    "timestamp",
    "preset_mode",
    "confidence_score",
    "validation_errors",
    "payload",
    "nextStepRouting"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "warning", "failed", "SCHEMA_MISMATCH"],
      "description": "Status final da execução da skill e do validador validate-telemetry-plan.ts."
    },
    "skill_id": {
      "type": "string",
      "const": "07-telemetry-and-impact",
      "description": "Identificador canônico da skill 07-telemetry-and-impact."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 da conclusão da análise de telemetria e impacto."
    },
    "preset_mode": {
      "type": "string",
      "enum": ["freelance", "enterprise", "default"],
      "description": "Perfil operacional em que o plano/relatório foi gerado."
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Grau de confiança calculado pelo script validate-telemetry-plan.ts."
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "field_or_line": { "type": "string" }
        }
      },
      "description": "Lista de violações de taxonomia snake_case, ausência de guardrails ou alertas de SRM."
    },
    "payload": {
      "type": "object",
      "required": [
        "report_artifact_path",
        "heart_metrics",
        "tracking_events",
        "guardrail_metrics",
        "experiment_verdict",
        "episodic_entry_logged"
      ],
      "properties": {
        "report_artifact_path": {
          "type": "string",
          "description": "Caminho do relatório executivo de telemetria e impacto gerado."
        },
        "heart_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "goal", "signal", "metric", "is_primary"],
            "properties": {
              "dimension": {
                "type": "string",
                "enum": ["Happiness", "Engagement", "Adoption", "Retention", "Task Success"]
              },
              "goal": { "type": "string" },
              "signal": { "type": "string" },
              "metric": { "type": "string" },
              "is_primary": { "type": "boolean" }
            }
          }
        },
        "tracking_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event_name", "trigger_state", "required_properties"],
            "properties": {
              "event_name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)+$"
              },
              "trigger_state": { "type": "string" },
              "required_properties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "guardrail_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric_name", "threshold", "status"],
            "properties": {
              "metric_name": { "type": "string" },
              "threshold": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["PASS", "BREACHED", "MONITORING"]
              }
            }
          }
        },
        "experiment_verdict": {
          "type": "string",
          "enum": [
            "SHIP",
            "ITERATE_UI",
            "REFRAME_DISCOVERY",
            "AWAITING_DATA",
            "INVALID_SRM_OR_DATA"
          ],
          "description": "Decisão executiva baseada na significância estatística e nas Guardrail Metrics."
        },
        "ab_statistics": {
          "type": "object",
          "properties": {
            "relative_lift_pct": { "type": "number" },
            "z_score": { "type": "number" },
            "p_value": { "type": "number" },
            "statistically_significant": { "type": "boolean" },
            "srm_detected": { "type": "boolean" }
          }
        },
        "episodic_entry_logged": {
          "type": "boolean",
          "description": "Confirmação de que o aprendizado foi gravado em memory/episodic/experiments-log.jsonl."
        }
      }
    },
    "nextStepRouting": {
      "type": "object",
      "required": ["recommendedPath", "pathA", "pathB"],
      "properties": {
        "recommendedPath": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "pathA": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": {
              "type": "string",
              "enum": ["03-design-system-tokens", "06-zero-drift-handoff", "product-scale-consolidation"]
            },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "pathB": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": {
              "type": "string",
              "enum": ["01-briefing-discovery", "02-information-architecture"]
            },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    }
  }
}
