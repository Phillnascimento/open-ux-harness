{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open UX Harness — Skill 03 Design Tokens State Contract",
  "description": "Schema determinístico salvo em .harness/memory/tokens-state.json após validação W3C DTCG 2025.10, resolução de aliases e verificação de grade espacial 4pt/8pt.",
  "type": "object",
  "required": [
    "status",
    "skill_id",
    "timestamp",
    "preset_mode",
    "confidence_score",
    "validation_errors",
    "payload",
    "nextStepRouting"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "warning", "failed", "SCHEMA_MISMATCH"]
    },
    "skill_id": {
      "type": "string",
      "const": "03-design-tokens"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "preset_mode": {
      "type": "string",
      "enum": ["freelance", "enterprise", "default"]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "field_or_line": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "dtcg_version",
        "tokens_file_path",
        "color_space",
        "spatial_grid_base_px",
        "total_primitive_tokens",
        "total_semantic_tokens",
        "aliases_resolved",
        "themes_supported"
      ],
      "properties": {
        "dtcg_version": {
          "type": "string",
          "const": "2025.10"
        },
        "tokens_file_path": {
          "type": "string",
          "description": "Caminho do arquivo JSON de tokens validado no projeto."
        },
        "color_space": {
          "type": "string",
          "enum": ["oklch", "hex", "hybrid-oklch-hex"]
        },
        "spatial_grid_base_px": {
          "type": "number",
          "enum": [4, 8]
        },
        "total_primitive_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "total_semantic_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "aliases_resolved": {
          "type": "boolean",
          "description": "True quando 100% dos aliases {a.b.c} apontam para nós válidos sem referências circulares."
        },
        "themes_supported": {
          "type": "array",
          "items": { "type": "string", "enum": ["light", "dark", "high-contrast"] }
        }
      }
    },
    "nextStepRouting": {
      "type": "object",
      "required": ["recommendedPath", "pathA", "pathB"],
      "properties": {
        "recommendedPath": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "pathA": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": { "type": "string", "const": "04-figma-engineering" },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        },
        "pathB": {
          "type": "object",
          "required": ["targetSkillId", "label", "rationale"],
          "properties": {
            "targetSkillId": { "type": "string", "const": "05-craft-and-accessibility" },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    }
  }
}
